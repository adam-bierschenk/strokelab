generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  rounds        Round[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model Course {
  id          String   @id @default(cuid())
  name        String
  location    String?
  city        String?
  state       String?
  par         Int
  totalYards  Int?     @map("total_yards")
  rating      Float?   // Course rating (e.g., 72.1)
  slope       Int?     // Slope rating (e.g., 130)
  holes       Hole[]
  rounds      Round[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("courses")
}

model Hole {
  id       String @id @default(cuid())
  number   Int
  par      Int
  yardage  Int?
  handicap Int?
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scores   Score[]

  @@unique([courseId, number])
  @@map("holes")
}

model Round {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id])
  date        DateTime @default(now())
  totalScore  Int      @default(0) @map("total_score")
  totalPutts  Int      @default(0) @map("total_putts")
  differential Float?  // USGA differential for handicap calculation
  fairwaysHit Int?     @map("fairways_hit") // Number of fairways hit
  greensInReg Int?     @map("greens_in_reg") // Number of greens in regulation
  notes       String?
  scores      Score[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("rounds")
}

model Score {
  id          String @id @default(cuid())
  roundId     String @map("round_id")
  round       Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  holeId      String @map("hole_id")
  hole        Hole   @relation(fields: [holeId], references: [id])
  score       Int    @default(0)
  putts       Int    @default(0)
  fairwayHit  Boolean? @map("fairway_hit") // Did player hit the fairway?
  greenInReg  Boolean? @map("green_in_reg") // Did player hit GIR?

  @@unique([roundId, holeId])
  @@map("scores")
}
